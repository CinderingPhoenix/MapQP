{
  "expo": {
    "name": "mapqpApp",
    "slug": "mapqpApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mapqpapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition for finding WPI buildings.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone for voice search.",
        "NSLocationWhenInUseUsageDescription": "Allow $(PRODUCT_NAME) to use your precise location for campus routing."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "config": {},
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.mapqpApp",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/mapqp-logo.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone for voice search.",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to use speech recognition for finding WPI buildings."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your precise location for campus routing."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "SERVER_IP": "10.0.2.2",
      "PORT": "8000",
      "PUBLIC_KEY": "-----BEGIN PUBLIC KEY-----\\\\n-----END PUBLIC KEY-----",
      "AUTHORITY": "https://login.microsoftonline.com/589c76f5-ca15-41f9-884b-55ec15a0672a",
      "CLIENT_ID": "e3f4b793-f667-499a-9c43-908bb2dcab89",
      "eas": {
        "projectId": "2c0f1be9-f804-498c-abb1-44dc68982e2f"
      }
    }
  }
}